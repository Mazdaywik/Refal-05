*$FROM LibraryEx
$EXTERN SaveFile, MapAccum, Map, Inc;

*$FROM R5FW-Plainer
$EXTERN InlineExpr;


/**
  <Generate-ToFile (e.OutputFile) e.Tree> == пусто
*/
$ENTRY Generate-ToFile {
  (e.OutputFile) e.Tree
    = <SaveFile
        (e.OutputFile)
        <R05-Generate-Combine
          <MapAccum generator_GenTreeItem (/* declarations */) e.Tree>
        >
      >;
}

R05-Generate-Combine {
  (e.Declarations) e.Definitions =
    ('/* Automatically generated file. Don\'t edit! */')
    ('#include "refal05rts.h"')
    ()
    ()
    e.Declarations
    ()
    e.Definitions
    ()
    ('/* End of file */')
}

$ENTRY generator_GenTreeItem {
  (e.Declarations) (Extern e.Names) =
    (e.Declarations <Map generator_GenExtern e.Names>)
    /* пусто */;

  (e.Declarations) (Function t.SrcPos (e.Name) s.ScopeClass /* пусто */)
    = (e.Declarations <GenEmptyDefinition e.Name s.ScopeClass>)
      <AssertOneOf s.ScopeClass in (Local Meta)>
      /* пусто */;

  (e.Declarations) (Function t.SrcPos (e.Name) s.ScopeClass e.Body) =
    (e.Declarations <GenDeclaration s.ScopeClass e.Name>)
    <GenFunction s.ScopeClass (e.Name) e.Body>;

  (e.Declarations) (Metatable e.Names)
    = (e.Declarations)
      ('static const struct r05_function *metatable_entries[] = {')
      <Map generator_MetatableName e.Names>
      ('};')
      ()
      ('static const struct r05_metatable metatable = {')
      ('  sizeof(metatable_entries) / sizeof(metatable_entries[0]),')
      ('  metatable_entries')
      ('};')
      ();
}

$ENTRY generator_MetatableName {
  (e.Name) = ('  &r05f_' <EscapeName e.Name> ',');
}

$ENTRY generator_GenExtern {
  (t.SrcPos e.Name) = <GenDeclaration Entry e.Name>;
}


Scope {
  Entry = 'ENTRY'; Local = 'LOCAL';
}

GenEmptyDefinition {
  /* поддержка пустого составного символа "" */
  /* пусто */ s.ScopeClass
    = ('static struct r05_function r05f_ = { r05_enum_function_code, "" };');

  e.Name Meta = ('R05_DEFINE_METAFUNCTION(' <DefName e.Name> ')');

  e.Name s.ScopeClass
    = ('R05_DEFINE_' <Scope s.ScopeClass> '_ENUM(' <DefName e.Name> ')');
}

GenDeclaration {
  /* поддержка пустого составного символа "" */
  s.ScopeClass /* пусто */
    = <AssertOneOf s.ScopeClass in (Entry)>
      ('extern struct r05_function r05f_;');

  s.ScopeClass e.Name =
    ('R05_DECLARE_' <Scope s.ScopeClass> '_FUNCTION(' <EscapeName e.Name> ')');
}

GenFunction {
  s.ScopeClass (e.Name) e.Sentences
    = <GenFunction-WrapBody s.ScopeClass (e.Name) <GenBody e.Sentences>>;
}

GenFunction-WrapBody {
  s.ScopeClass (e.Name) (s.MaxStack s.NCondFunctions) e.Lines
    = ('R05_DEFINE_' <Scope s.ScopeClass> '_FUNCTION(' <DefName e.Name> ') {')
      <GenCondFunctions e.Name s.NCondFunctions>
      ('  struct r05_node *p[' <Symb s.MaxStack> '] = { 0 };')
      ()
      ('  r05_this_is_generated_function();')
      e.Lines
      ('}')
      ();
}

GenCondFunctions {
  e.Name 0 = /* нет cond-функций */;

  e.Name s.N
    , <Symb s.N> : e.N
    , <EscapeName e.Name> : e.EscName
    , '"' <EscapeString e.Name '$' e.N> '"' : e.StrName
    = <GenCondFunctions e.Name <- s.N 1>>
      ('  R05_DEFINE_COND_FUNCTION(' e.EscName ', ' e.StrName ', ' e.N ')');
}

GenBody {
  e.Sentences = <GenBody-Aux <CompileBody 0 0 (/* контекст */) e.Sentences>>;
}

GenBody-Aux {
  (s.MaxStack s.NCondFunctions s.LastPattern) e.Commands
    = (s.MaxStack s.NCondFunctions)
      <SkipIndentAccum
        <MapAccum
          generator_GenCommand
          ('  ' /* отступ */)
          <WrapSwitchIfNeed
            s.NCondFunctions
            (CmdInitHole0 0)
            <BeautifySentences e.Commands <AddFailCommand s.LastPattern>>
          >
        >
      >;
}

WrapSwitchIfNeed {
  0 e.Commands = e.Commands;

  s.NCondFunctions e.Commands
    = (CmdStartSwitch) (CmdResume 0) e.Commands (CmdEndSwitch);
}

BeautifySentences {
  e.Commands-B (CmdEndSentence) (CmdStartSentence) e.Commands-E
    = e.Commands-B (CmdEndSentence) (CmdNL) (CmdStartSentence)
      <BeautifySentences e.Commands-E>;

  e.Commands = e.Commands;
}

CmdNL { (e.Indent) = () }

AssertOneOf { s.One in (e.Variants-B s.One e.Variants-E) = }


DefName {
  e.Name = <EscapeName e.Name> ', "' <EscapeString e.Name> '"';
}

/*
  Разрешим знак $ для функций Stop$$ и Imp$$ на всякий случай.
  Декорирование было выбрано именно таким, чтобы избежать двух прочерков
  подряд в декорированном имени.
*/
EscapeName {
  e.Name = <EscapeName-GlueCodes <Map generator_EscapeNameChar e.Name>>;
}

$ENTRY generator_EscapeNameChar {
  '_' = (e 'u_');
  '-' = (e 'm-');
  '$' = (e 'd$');

  s.Other
    , <Type s.Other>
    : {
        'L' s.st_ s.Letter = (c s.Letter);
        'D' s.st_ s.Digit = (c s.Digit);

* TODO: юникод
        s.t_ s.st_ s.Encoded = (k <EscapeNameChar-Code s.Encoded>);
      };
}

EscapeNameChar-Code {
  s.Char, <Ord s.Char> : s.Code = <Hex </ s.Code 16>> <Hex <% s.Code 16>>;
}

EscapeName-GlueCodes {
  (k e.Code1) (k e.Code2) e.Name
    = <EscapeName-GlueCodes (k e.Code1 e.Code2) e.Name>;

  (k e.Code1) (c s.Char) (k e.Code2) e.Name
    = <EscapeName-GlueCodes
        (k e.Code1 <EscapeNameChar-Code s.Char> e.Code2) e.Name
      >;

  (k e.Code1) (e s.Escape_ s.Char) (k e.Code2) e.Name
    = <EscapeName-GlueCodes
        (k e.Code1 <EscapeNameChar-Code s.Char> e.Code2) e.Name
      >;

  (k e.Code) e.Name = 'k' e.Code '_' <EscapeName-GlueCodes e.Name>;
  (e s.Escape s.Char_) e.Name = s.Escape '_' <EscapeName-GlueCodes e.Name>;
  (c s.Char) e.Name = s.Char <EscapeName-GlueCodes e.Name>;
  /* пусто */ = /* пусто */;
}

Hex {
  10 = 'A'; 11 = 'B'; 12 = 'C'; 13 = 'D'; 14 = 'E'; 15 = 'F';

  s.Dec = <Symb s.Dec>;
}

AddFailCommand {
  /*
    если последнее предложение имеет вид
    e.X = ...;, в конце не генерится вызов
    r05_recognition_impossible()
  */
  EXPattern = /* пусто */;
  RegularPattern = (CmdReturnRecognitionImpossible);
}

Max {
  s.X s.Y, <Compare s.X s.Y> : '+' = s.X;
  s.X s.Y = s.Y;
}

SkipIndentAccum {
  /* отступ должен остаться тем же */
  ('  ') e.Generated = e.Generated;
}

SafeComment {
  e.Comment-B '/*' e.Comment-E =
    <SafeComment e.Comment-B '/\' \'*' e.Comment-E>;

  e.Comment-B '*/' e.Comment-E =
    <SafeComment e.Comment-B '*\' \'/' e.Comment-E>;

  e.Comment = e.Comment;
}

$ENTRY generator_GenCommand {
  (e.Indent) (CmdStartSwitch)
    = (e.Indent '  ')
      ('  switch (arg_begin->next->info.function->resume_entry >> 1) {');

  (e.Indent '  ') (CmdEndSwitch) = (e.Indent) (e.Indent '}');

  (e.Indent) (CmdStartSentence) = (e.Indent '  ') (e.Indent 'do {');
  (e.Indent '  ') (CmdEndSentence) = (e.Indent) (e.Indent '} while (0);');

  (e.Indent) (CmdOpenedE-Start s.L s.E s.R 'e' e.Index)
    = (e.Indent '  ') <CmdOpenedE-Start (e.Indent) s.L s.E s.R 'e' e.Index>;

  (e.Indent '  ') (CmdOpenedE-End s.L s.E s.R 'e' e.Index)
    = (e.Indent) <CmdOpenedE-End (e.Indent) s.L s.E s.R 'e' e.Index>;

  (e.Indent) (s.Command e.Args) = (e.Indent) <Mu s.Command (e.Indent) e.Args>;
}

CmdComment {
  (e.Indent) e.Text = (e.Indent '/* ' <SafeComment e.Text> ' */');
}

CmdInitHole0 {
  (e.Indent) s.StartStack
    = (e.Indent <Elem s.StartStack> ' = arg_begin;')
      (e.Indent <Elem <+ s.StartStack 1>> ' = arg_begin->next;')
      (e.Indent <Elem <+ s.StartStack 2>> ' = arg_end;')
      ();
}

CmdMatch {
  (e.Indent) s.Dir s.L s.E s.R s.Stack s.Type e.Value
    , 'r05_' <MatchFunc s.Type e.Value> '_' <StrFromDir s.Dir> : e.Func
    , <ElemPtr s.Stack> ', ' <ElemLR s.L s.E s.R> : e.Range
    = (e.Indent 'if (! ' e.Func '(' e.Range <MatchArgs s.Type e.Value> '))')
      (e.Indent '  continue;');
}

MatchFunc {
  Symbol s.Type e.Value = <SymbolFunc s.Type>;
  Brackets = 'brackets';
  Repeated s.Mode s.SampleOffset = 'repeated_' s.Mode 'var';
  Variable 's' = 'svar';
  Variable 't' = 'tvar';
}

SymbolFunc {
  Char = 'char';
  Number = 'number';
  Word = 'function';
}

StrFromDir {
  LEFT = 'left'; RIGHT = 'right';
}

MatchArgs {
  Symbol s.Type e.Value = ', ' <SymbolTextRep s.Type e.Value>;
  Brackets = /* пусто */;
  Repeated s.Mode s.SampleOffset = ', ' <ElemPtr s.SampleOffset>;
  Variable s.Mode = /* пусто */;
}

SymbolTextRep {
  Char s.Char = '\'' <generator_EscapeChar s.Char> '\'';
  Number s.Number = <Symb s.Number> 'UL';
  Word CondFunction s.No = '&c' <Symb s.No>;
  Word e.Name = '&r05f_' <EscapeName e.Name>;
}

CmdEmpty {
  (e.Indent) s.L s.E s.R
    = (e.Indent 'if (! r05_empty_hole(' <ElemLR s.L s.E s.R> '))')
      (e.Indent '  continue;');
}

CmdClosedE {
  (e.Indent) s.L s.E s.R 'e' s.Offset
    = (e.Indent
        'r05_close_evar(' <ElemPtr s.Offset> ', ' <ElemLR s.L s.E s.R> ');'
      );
}

CmdOpenedE-Start {
  (e.Indent) s.L s.E s.R 'e' s.Offset
    = (e.Indent <Elem s.Offset> ' = NULL;')
      (e.Indent <Elem <Inc s.Offset>> ' = ' <Elem s.L> ';')
      (e.Indent 'do {')
      (e.Indent '  r05_start_e_loop();');
}

CmdOpenedE-End {
  (e.Indent) s.L s.E s.R 'e' s.Offset
    = (e.Indent
        '} while (r05_open_evar_advance('
        <ElemPtr s.Offset> ', ' <ElemR s.E s.R>
        '));'
      );
}

CmdStopProfileELoop {
  (e.Indent) = (e.Indent 'r05_stop_e_loop();');
}

CmdEmptyResult {
  (e.Indent) = () (e.Indent 'r05_reset_allocator();');
}

CmdAllocateElem {
  (e.Indent) s.ElementType e.Info =
    (e.Indent 'r05_alloc_' <Mu s.ElementType e.Info>);
}

ElSymbol {
  s.Type e.Value = <SymbolFunc s.Type> '(' <SymbolTextRep s.Type e.Value> ');';
}

ElString {
  s.Len e.String = 'chars("' <EscapeString e.String> '", ' <Symb s.Len> ');';
}

ElOpenBracket { s.Pos = 'open_bracket(' <ElemPtr s.Pos> ');' }
ElCloseBracket { s.Pos = 'close_bracket(' <ElemPtr s.Pos> ');' }
ElOpenCall { s.Pos = 'open_call(' <ElemPtr s.Pos> ');' }
ElCloseCall { s.Pos = 'close_call(' <ElemPtr s.Pos> ');' }

ElSavePos { s.Pos = 'insert_pos(' <ElemPtr s.Pos> ');' }

ElVariable { s.Mode s.Offset = s.Mode 'var(' <ElemPtr s.Offset> ');' }

CmdLinkBrackets {
  (e.Indent) s.Left s.Right =
    (e.Indent 'r05_link_brackets(' <Elem s.Left> ', ' <Elem s.Right> ');');
}

CmdPushStack {
  (e.Indent) s.ElemNumber =
    (e.Indent 'r05_push_stack(' <Elem s.ElemNumber> ');');
}

CmdInsertVar {
  (e.Indent) s.Pos s.Mode s.Offset
    = (e.Indent
        'r05_splice_' s.Mode 'var(' <Elem s.Pos> ', ' <ElemPtr s.Offset> ');'
      );
}

CmdSpliceFromFreeList {
  (e.Indent) s.InsertPos
    = (e.Indent 'r05_splice_from_freelist(' <Elem s.InsertPos> ');');
}

CmdSpliceToFreeList {
  (e.Indent) s.Begin s.End
    , <Elem s.Begin> ', ' <Elem s.End> : e.Range
    = (e.Indent 'r05_splice_to_freelist(' e.Range ');');
}

CmdReturn {
  (e.Indent) = (e.Indent 'return;');
}

CmdSaveContext {
  (e.Indent) s.ContextSize
    = (e.Indent 'r05_push_context(p, ' <Symb s.ContextSize> ');');
}

CmdResume {
  (e.Indent) 0 = ('  case 0:');
  (e.Indent) s.Point = () ('  case ' <Symb s.Point> ':');
}

CmdRestoreContext {
  (e.Indent) s.ContextSize
    = (e.Indent 'r05_pop_context(p, ' <Symb s.ContextSize> ');');
}

CmdReturnRecognitionImpossible {
  (e.Indent) = () (e.Indent 'r05_recognition_impossible();');
}

EscapeString {
  e.String = <Map generator_EscapeChar e.String>;
}

$ENTRY generator_EscapeChar {
  '\n' = '\\n';
  '\t' = '\\t';
  '\r' = '\\r';
  '\'' = '\\\'';
  '\"' = '\\\"';
  '\\' = '\\\\';

  s.Other
    , <Ord s.Other> : s.Code
    , <Compare 31 s.Code> <Compare s.Code 128>
    : {
        '-' '-' = s.Other;

        s.Compare1 s.Compare2
          , <Divmod s.Code 64> : (s.1) s.23
          , <Divmod s.23 8> : (s.2) s.3
          = '\\' <Symb s.1> <Symb s.2> <Symb s.3>;
      };
}

Elem { s.Number = 'p[' <Symb s.Number> ']' }
ElemPtr { s.Number = 'p+' <Symb s.Number> }

ElemR {
  X s.R = <Elem s.R>;
  E s.R = 'r05_evar_true_begin(' <ElemPtr s.R> ')';
}

ElemLR { s.L s.E s.R = <Elem s.L> ', ' <ElemR s.E s.R> }


*===============================================================================
* Генерация абстрактного кода для предложения
*===============================================================================

CompileBody {
  s.StartStack s.NCondFunctions (e.Context) e.Sentences
    = <MapAccum
        (generator_CompileSentence s.StartStack e.Context)
        (s.StartStack s.NCondFunctions RegularPattern)
        e.Sentences
      >;
}

$ENTRY generator_CompileSentence {
  s.StartStack e.Context
  (s.MaxStack s.NCondFunctions s.LastPattern)
  ((e.Pattern) e.SentenceTail)

    , <GenPattern s.StartStack (e.Context) e.Pattern>
    : s.PatStack (e.PatternVars) (e.PatternCommands)

    , <CompileSentenceTail
        s.PatStack s.NCondFunctions (e.PatternVars) e.SentenceTail
      >
    : s.Stack s.NewNCondFunctions e.TailCommands

    = (
        <Max s.MaxStack s.Stack>
        s.NewNCondFunctions
        <CompileSentence-PatternType e.PatternCommands>
      )
      <WrapSentence
        (e.PatternVars) (e.Pattern) e.PatternCommands (e.TailCommands)
      >;
}

WrapSentence {
  (e.PatternVars) (e.Pattern) e.PatternCommands (e.TailCommands)
    = (CmdStartSentence)
      <AddStopProfileELoop
        <CompileSentence-OpenELoops
          <Map generator_MakeDeclaration e.PatternVars>
          (CmdComment <InlineExpr e.Pattern>)
          e.PatternCommands
          (e.TailCommands)
        >
      >
      (CmdEndSentence);
}

AddStopProfileELoop {
  e.Commands (CmdOpenedE-End s.L s.E s.R 'e' s.Stack)
    = e.Commands
      (CmdOpenedE-End s.L s.E s.R 'e' s.Stack)
      (CmdStopProfileELoop);

  e.Commands = e.Commands;
}

CompileSentenceTail {
  s.PatStack s.NCondFunctions (e.PatternVars)
  RETURN (e.Result)
    , <GenResult s.PatStack (e.PatternVars) e.Result> : s.Stack e.ResultCommands
    = s.Stack s.NCondFunctions
      (CmdEmptyResult)
      e.ResultCommands
      (CmdSpliceFromFreeList 0)
      (CmdSpliceToFreeList 0 2)
      (CmdReturn);

  s.PatStack s.NCondFunctions (e.PatternVars)
  CALL-BLOCK (e.Result) e.BlockSentences

    , <Inc s.NCondFunctions> : s.CondFunction

    , <GenResult
        s.PatStack
        (<Map generator_FreeseVars e.PatternVars>)
        (Call NO-POS (CondFunction s.CondFunction) e.Result)
      >
    : s.ResStack e.ResultCommands

    , <CompileBody
        s.PatStack <Inc s.NCondFunctions> (e.PatternVars) e.BlockSentences
      >
    : (s.SentencesStack s.NewNCondFunctions s.LastPattern) e.SentencesCommands

    = <Max s.ResStack s.SentencesStack> s.NewNCondFunctions
      (CmdEmptyResult)
      e.ResultCommands
      (CmdSaveContext s.PatStack)
      (CmdSpliceFromFreeList 2)
      (CmdReturn)
      (CmdResume s.CondFunction)
      (CmdRestoreContext s.PatStack)
      (CmdInitHole0 s.PatStack)
      e.SentencesCommands <AddFailCommand s.LastPattern>;

  s.PatStack s.NCondFunctions (e.PatternVars)
  (Condition (e.CondResult) (e.CondPattern)) e.SentenceTail

    , <Inc s.NCondFunctions> : s.CondFunction

    , <GenResult
        s.PatStack
        (<Map generator_FreeseVars e.PatternVars>)
        (Call NO-POS (CondFunction s.CondFunction) e.CondResult)
      >
    : s.ResStack e.ResultCommands

    , <GenPattern s.PatStack (e.PatternVars) e.CondPattern>
    : s.NewPatStack (e.NewPatternVars) (e.PatternCommands)

    , <CompileSentenceTail
        s.NewPatStack <+ s.NCondFunctions 1> (e.NewPatternVars) e.SentenceTail
      >
    : s.Stack s.NewNCondFunctions e.TailCommands

    = <Max s.ResStack s.Stack> s.NewNCondFunctions
      (CmdEmptyResult)
      e.ResultCommands
      (CmdSaveContext s.PatStack)
      (CmdSpliceFromFreeList 2)
      (CmdReturn)
      (CmdResume s.CondFunction)
      (CmdRestoreContext s.PatStack)
      (CmdInitHole0 s.PatStack)
      <WrapSentence
        (e.NewPatternVars)
        (e.CondPattern)
        e.PatternCommands
        (e.TailCommands)
      >
      (CmdSpliceToFreeList s.PatStack <+ s.PatStack 2>);
}

$ENTRY generator_FreeseVars {
  (s.Mode e.Index s.Sample (e.Insts)) = (s.Mode e.Index s.Sample ());
}

CompileSentence-PatternType {
  (CmdClosedE s.L s.E s.R 'e' s.Pos) = EXPattern;
  e.PatternCommands = RegularPattern;
}

$ENTRY generator_MakeDeclaration {
  (s.Mode e.Index s.Sample (s.Inst e.Insts))
    = (CmdComment
        s.Mode '.' e.Index ': '
        <Symb s.Inst> <Map r05-generator-SymbInst e.Insts>
      );
}

$ENTRY r05-generator-SymbInst { s.Inst = ', ' <Symb s.Inst> }

CompileSentence-OpenELoops {
  e.Commands-B (CmdOpenedE s.L s.E s.R 'e' s.Stack) e.Commands-E (e.TailCommands)
    = e.Commands-B
      (CmdOpenedE-Start s.L s.E s.R 'e' s.Stack)
      <CompileSentence-OpenELoops e.Commands-E (e.TailCommands)>
      (CmdOpenedE-End s.L s.E s.R 'e' s.Stack);

  e.Commands (e.TailCommands) = e.Commands e.TailCommands;
}

/*
  e.Vars ::= (s.Mode e.Index s.SampleOffset (e.Instances))*
  e.Instances ::= s.Offset+
*/

*===============================================================================
* Генерация образца
*===============================================================================

/*
Команды распознавания
  Символы, скобки, повторные переменные и s-, t-переменные:
    (CmdMatch s.Direction s.L s.E s.R s.ElemPtr s.MatchType e.MatchValue)

    s.Direction ::= LEFT | RIGHT
    s.E ::= X | E

    s.MatchType e.MatchValue ::=
        Symbol Char s.Char
      | Symbol Number s.Number
      | Symbol Word e.Name
      | Brackets
      | Repeated s.Mode s.Sample
      | Variable s.Mode

  Пустые скобки:
    (CmdEmpty s.L s.E s.R),

  Открытые e-переменные до обработки:
    (CmdOpenedE s.L s.E s.R 'e' s.Offset)

  Открытые e-переменные после обработки:
    (CmdOpenedE-Start s.L s.E s.R 'e' s.Offset)
    (CmdOpenedE-End s.L s.E s.R 'e' s.Offset)

  Закрытые e-переменные:
    (CmdClosedE s.L s.E s.R 'e' s.Offset)

  Комментарий, вносимый в исходный код:
    (CmdComment e.Text)
*/

GenPattern {
  s.StartStack (e.Context) e.Pattern
    = <DoGenPattern
        <+ s.StartStack 3>
        (<+ s.StartStack 1> e.Pattern X <+ s.StartStack 2>)
        (e.Context)
        (/* команды */)
      >;
}

Inc2 { s.N = <+ s.N 2> }

VarSize {
  's' = 1; 't' = 2; 'e' = 2;
}

IncMode { s.N s.Mode = <+ s.N <VarSize s.Mode>> }

VarRightSide {
  s.N 's' = s.N;
  s.N s.TE = <Inc s.N>;
}

RightSideType {
  'e' = E;
  s.Other = X;
}

DoGenPattern {
  /* Распознавание литералов (символьных, целочисленных, имён) */
  s.Stack e.Holes-B (s.L (Symbol s.Type e.Value) e.Hole s.E s.R) e.Holes-E
  (e.Vars) (e.Commands)
    = <DoGenPattern
        <Inc s.Stack> e.Holes-B (s.Stack e.Hole s.E s.R) e.Holes-E (e.Vars)
        (e.Commands (CmdMatch LEFT s.L s.E s.R s.Stack Symbol s.Type e.Value))
      >;

  s.Stack e.Holes-B (s.L e.Hole (Symbol s.Type e.Value) s.E s.R) e.Holes-E
  (e.Vars) (e.Commands)
    = <DoGenPattern
        <Inc s.Stack> e.Holes-B (s.L e.Hole X s.Stack) e.Holes-E (e.Vars)
        (e.Commands (CmdMatch RIGHT s.L s.E s.R s.Stack Symbol s.Type e.Value))
      >;

  /* Распознавание скобок */
  s.Stack e.Holes-B (s.L (Brackets e.SubHole) e.Hole s.E s.R) e.Holes-E
  (e.Vars) (e.Commands)
    , s.Stack : s.LB
    , <Inc s.Stack> : s.RB
    = <DoGenPattern
        <Inc2 s.Stack>
        e.Holes-B (s.LB e.SubHole X s.RB) (s.RB e.Hole s.E s.R) e.Holes-E
        (e.Vars)
        (e.Commands (CmdMatch LEFT s.L s.E s.R s.LB Brackets))
      >;

  s.Stack e.Holes-B (s.L e.Hole (Brackets e.SubHole) s.E s.R) e.Holes-E
  (e.Vars) (e.Commands)
    , s.Stack : s.LB
    , <Inc s.Stack> : s.RB
    = <DoGenPattern
        <Inc2 s.Stack>
        e.Holes-B (s.L e.Hole X s.LB) (s.LB e.SubHole X s.RB) e.Holes-E
        (e.Vars)
        (e.Commands (CmdMatch RIGHT s.L s.E s.R s.LB Brackets))
      >;

  /* Пустой диапазон */
  s.Stack e.Holes-B (s.L /* пусто */ s.E s.R) e.Holes-E (e.Vars) (e.Commands)
    = <DoGenPattern
        s.Stack e.Holes-B e.Holes-E (e.Vars) (e.Commands (CmdEmpty s.L s.E s.R))
      >;

  /* Распознавание переменных */
  s.Stack
  e.Holes-B (s.L (Variable t.SrcPos s.Mode e.Index) e.Hole s.E s.R) e.Holes-E
  (e.Vars-B (s.Mode e.Index s.Sample (e.Insts)) e.Vars-E) (e.Commands)
    , <VarRightSide s.Stack s.Mode> : s.VarRight
    = <DoGenPattern
        <IncMode s.Stack s.Mode> e.Holes-B (s.VarRight e.Hole s.E s.R) e.Holes-E
        (e.Vars-B (s.Mode e.Index s.Sample (e.Insts s.Stack)) e.Vars-E)
        (
          e.Commands
          (CmdMatch LEFT s.L s.E s.R s.Stack Repeated s.Mode s.Sample)
        )
      >;

  s.Stack
  e.Holes-B (s.L e.Hole (Variable t.SrcPos s.Mode e.Index) s.E s.R) e.Holes-E
  (e.Vars-B (s.Mode e.Index s.Sample (e.Insts)) e.Vars-E) (e.Commands)
    , <RightSideType s.Mode> : s.NewE
    = <DoGenPattern
        <IncMode s.Stack s.Mode> e.Holes-B (s.L e.Hole s.NewE s.Stack) e.Holes-E
        (e.Vars-B (s.Mode e.Index s.Sample (e.Insts s.Stack)) e.Vars-E)
        (
          e.Commands
          (CmdMatch RIGHT s.L s.E s.R s.Stack Repeated s.Mode s.Sample)
        )
      >;

  /* Диапазон с закрытой переменной */
  s.Stack e.Holes-B (s.L (Variable t.SrcPos 'e' e.Index) s.E s.R) e.Holes-E
  (e.Vars) (e.Commands)
    = <DoGenPattern
        <IncMode s.Stack 'e'> e.Holes-B e.Holes-E
        (e.Vars ('e' e.Index s.Stack (s.Stack)))
        (e.Commands (CmdClosedE s.L s.E s.R 'e' s.Stack))
      >;

  s.Stack
  e.Holes-B (s.L (Variable t.SrcPos 's' e.Index) e.Hole s.E s.R) e.Holes-E
  (e.Vars) (e.Commands)
    , <VarRightSide s.Stack 's'> : s.VarRight
    = <DoGenPattern
        <IncMode s.Stack 's'> e.Holes-B (s.VarRight e.Hole s.E s.R) e.Holes-E
        (e.Vars ('s' e.Index s.Stack (s.Stack)))
        (e.Commands (CmdMatch LEFT s.L s.E s.R s.Stack Variable 's'))
      >;

  s.Stack
  e.Holes-B (s.L (Variable t.SrcPos 't' e.Index) e.Hole s.E s.R) e.Holes-E
  (e.Vars) (e.Commands)
    , <VarRightSide s.Stack 't'> : s.VarRight
    = <DoGenPattern
        <IncMode s.Stack 't'> e.Holes-B (s.VarRight e.Hole s.E s.R) e.Holes-E
        (e.Vars ('t' e.Index s.Stack (s.Stack)))
        (e.Commands (CmdMatch LEFT s.L s.E s.R s.Stack Variable 't'))
      >;

  s.Stack
  e.Holes-B (s.L e.Hole (Variable t.SrcPos 's' e.Index) s.E s.R) e.Holes-E
  (e.Vars) (e.Commands)
    = <DoGenPattern
        <IncMode s.Stack 's'> e.Holes-B (s.L e.Hole X s.Stack) e.Holes-E
        (e.Vars ('s' e.Index s.Stack (s.Stack)))
        (e.Commands (CmdMatch RIGHT s.L s.E s.R s.Stack Variable 's'))
      >;

  s.Stack
  e.Holes-B (s.L e.Hole (Variable t.SrcPos 't' e.Index) s.E s.R) e.Holes-E
  (e.Vars) (e.Commands)
    = <DoGenPattern
        <IncMode s.Stack 't'> e.Holes-B (s.L e.Hole X s.Stack) e.Holes-E
        (e.Vars ('t' e.Index s.Stack (s.Stack)))
        (e.Commands (CmdMatch RIGHT s.L s.E s.R s.Stack Variable 't'))
      >;

  s.Stack
  e.Holes-B (s.L (Variable t.SrcPos 'e' e.Index) e.Hole s.E s.R) e.Holes-E
  (e.Vars) (e.Commands)
    , <VarRightSide s.Stack 'e'> : s.VarRight
    = <DoGenPattern
        <IncMode s.Stack 'e'> e.Holes-B (s.VarRight e.Hole s.E s.R) e.Holes-E
        (e.Vars ('e' e.Index s.Stack (s.Stack)))
        (e.Commands (CmdOpenedE s.L s.E s.R 'e' s.Stack))
      >;

  /* Завершение разбора. */
  s.Stack /* пусто */ (e.Vars) (e.Commands) =
    s.Stack (e.Vars) (e.Commands);
}

*===============================================================================
* Генерация результата
*===============================================================================

GenResult {
  s.Stack (e.PatternVars) e.Result =
    <DoGenResult
      (e.PatternVars)
      (/* alloc commands */) (/* other commands */)
      s.Stack
      e.Result
    >;
}

* Основные команды работы с образцом
*  (CmdAllocateElem s.Number s.ElType e.Info)
*  (CmdLinkBrackets s.Left s.Right)
*  (CmdPushStack s.Number)
*  (CmdInsertVar s.Pos s.Usings s.Mode e.Index)


/*
  Порядок выполнения команд.
  1. Все выделения памяти (в порядке перечисления)
  2. Связывание крулых и угловых скобок и
  построение результата (в обратном порядке)
*/

DoGenResult {
  /* Оптимизация для распределения последовательности char’ов */
  (e.Vars) (e.AllocCommands) (e.Commands) s.Stack
  (Symbol Char s.Char1) (Symbol Char s.Char2) e.Result =
    <DoGenResult
      (e.Vars) (e.AllocCommands) (e.Commands) s.Stack
      (TkString 2 s.Char1 s.Char2) e.Result
    >;

  (e.Vars) (e.AllocCommands) (e.Commands)
  s.Stack (Symbol Char s.Value) e.Result =
    <DoGenResult
      (e.Vars)
      (e.AllocCommands (CmdAllocateElem ElSymbol Char s.Value))
      (e.Commands)
      s.Stack e.Result
    >;

  (e.Vars) (e.AllocCommands) (e.Commands) s.Stack
  (TkString s.Len e.String) (Symbol Char s.Char) e.Result =
    <DoGenResult
      (e.Vars) (e.AllocCommands) (e.Commands) s.Stack
      (TkString <Inc s.Len> e.String s.Char) e.Result
    >;

  (e.Vars) (e.AllocCommands) (e.Commands) s.Stack
  (TkString s.Len e.String) e.Result =
    <DoGenResult
      (e.Vars)
      (e.AllocCommands (CmdAllocateElem ElString s.Len e.String))
      (e.Commands)
      s.Stack e.Result
    >;

  /* Создаём литералы */
  (e.Vars) (e.AllocCommands) (e.Commands)
  s.Stack (Symbol s.Type e.Value) e.Result =
    <DoGenResult
      (e.Vars)
      (e.AllocCommands (CmdAllocateElem ElSymbol s.Type e.Value))
      (e.Commands)
      s.Stack e.Result
    >;

  /*
    Обработка открывающих скобок всех типов осуществляется похоже.
  */
  (e.Vars) (e.AllocCommands) (e.Commands)
  s.Stack (Brackets e.InBrackets) e.Result =
    <DoGenResult
      (e.Vars)
      (e.AllocCommands (CmdAllocateElem ElOpenBracket s.Stack))
      (e.Commands)
      <Inc s.Stack> e.InBrackets (TkCloseBracket s.Stack) e.Result
    >;

  (e.Vars) (e.AllocCommands) (e.Commands)
  s.Stack (Call t.SrcPos (e.Name) e.InBrackets) e.Result =
    <DoGenResult
      (e.Vars)
      (e.AllocCommands (CmdAllocateElem ElOpenCall s.Stack))
      (e.Commands)
      <Inc s.Stack> (Symbol Word e.Name)
      e.InBrackets (TkCloseCall s.Stack) e.Result
    >;

  /*
    Закрывающие скобки надо обрабатывать особым образом.
    Круглые скобки — слинковать, угловые — добавить в стек.
  */
  (e.Vars) (e.AllocCommands) (e.Commands) s.Stack
  (TkCloseBracket s.OpenPos) e.Result =
    <DoGenResult
      (e.Vars)
      (e.AllocCommands (CmdAllocateElem ElCloseBracket s.Stack))
      (
        (CmdLinkBrackets s.OpenPos s.Stack)
        e.Commands
      )
      <Inc s.Stack> e.Result
    >;

  (e.Vars) (e.AllocCommands) (e.Commands) s.Stack
  (TkCloseCall s.OpenPos) e.Result =
    <DoGenResult
      (e.Vars)
      (e.AllocCommands (CmdAllocateElem ElCloseCall s.Stack))
      (
        (CmdPushStack s.Stack)
        (CmdPushStack s.OpenPos)
        e.Commands
      )
      <Inc s.Stack> e.Result
    >;

  /* Оптимизация: частный случай для s-переменных, их проще всегда копировать */
  (e.Vars-B ('s' e.Index s.Sample (e.Insts)) e.Vars-E)
  (e.AllocCommands) (e.Commands)
  s.Stack (Variable t.SrcPos 's' e.Index) e.Result
    = <DoGenResult
        (e.Vars-B ('s' e.Index s.Sample (e.Insts)) e.Vars-E)
        (e.AllocCommands (CmdAllocateElem ElVariable 's' s.Sample))
        (e.Commands)
        s.Stack e.Result
      >;

  /* Переменная есть в образце — переносим, позиция подготовлена */
  (e.Vars-B (s.Mode e.Index s.Sample (s.Inst e.Insts)) e.Vars-E)
  (e.AllocCommands (CmdAllocateElem ElSavePos s.InsertPos)) (e.Commands)
  s.Stack (Variable t.SrcPos s.Mode e.Index) e.Result
    = <DoGenResult
        (e.Vars-B (s.Mode e.Index s.Sample (e.Insts)) e.Vars-E)
        (e.AllocCommands (CmdAllocateElem ElSavePos s.InsertPos))
        /*
          Коррекцию всех переменных нужно осуществлять до переносов
          этих переменных. Переносы переменных выполняются в обратном
          порядке, т.к. операция переноса вставляет значение перед
          позицией вставки.
        */
        (e.Commands (CmdInsertVar s.InsertPos s.Mode s.Inst))
        s.Stack e.Result
      >;

  /* Переменная есть в образце — переносим, позиция не подготовлена */
  (e.Vars-B (s.Mode e.Index s.Sample (s.Inst e.Insts)) e.Vars-E)
  (e.AllocCommands) (e.Commands)
  s.Stack (Variable t.SrcPos s.Mode e.Index) e.Result
    = <DoGenResult
        (e.Vars-B (s.Mode e.Index s.Sample (e.Insts)) e.Vars-E)
        (e.AllocCommands (CmdAllocateElem ElSavePos s.Stack))
        /*
          Коррекцию всех переменных нужно осуществлять до переносов
          этих переменных. Переносы переменных выполняются в обратном
          порядке, т.к. операция переноса вставляет значение перед
          позицией вставки.
        */
        (e.Commands (CmdInsertVar s.Stack s.Mode s.Inst))
        <Inc s.Stack> e.Result
      >;

  /* Переменной нет в образце — копируем */
  (e.Vars-B (s.Mode e.Index s.Sample ()) e.Vars-E)
  (e.AllocCommands) (e.Commands)
  s.Stack (Variable t.SrcPos s.Mode e.Index) e.Result
    = <DoGenResult
        (e.Vars-B (s.Mode e.Index s.Sample ()) e.Vars-E)
        (e.AllocCommands (CmdAllocateElem ElVariable s.Mode s.Sample))
        (e.Commands)
        s.Stack e.Result
      >;

  /* Завершение просмотра */
  (e.UnusedVars) (e.AllocCommands) (e.Commands) s.Stack
    = s.Stack e.AllocCommands e.Commands;
}
